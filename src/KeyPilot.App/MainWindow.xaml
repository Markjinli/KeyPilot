                                        <Border Width="25" Height="25" CornerRadius="7" Background="{StaticResource KpAccentFillBrush}"><TextBlock Text="RC" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="7" FontWeight="Bold" Foreground="{StaticResource KpMintBrush}" /></Border>
                                        <StackPanel>
                                            <TextBlock Text="小米遥控器 2 Pro" FontSize="11" FontWeight="SemiBold" />
                                            <TextBlock Text="RC003 按键 · 麦克风在下方单独设置" Margin="0,2,0,0" FontSize="8" Foreground="{StaticResource KpMutedBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock x:Name="RemoteBackendStatusText" Text="等待遥控器 HID" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="8" Foreground="{StaticResource KpAmberBrush}" />
                                </Grid>
                                <Grid x:Name="RemoteBodyHost" Grid.Row="1" Padding="16,14,16,16">
