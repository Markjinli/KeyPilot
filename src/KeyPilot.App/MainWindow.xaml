<Window
    x:Class="KeyPilot.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="KeyPilot · 掌机按键工作台">

    <Grid x:Name="RootGrid" Background="{StaticResource KpBackgroundBrush}" KeyDown="RootGrid_KeyDown" SizeChanged="RootGrid_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="212" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource KpSidebarBrush}" BorderBrush="{StaticResource KpHairlineBrush}" BorderThickness="0,0,1,0">
            <Grid Padding="13,20,13,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0,8,22">
                    <Border Width="36" Height="36" CornerRadius="11" Background="{StaticResource KpMintBrush}">
                        <TextBlock Text="KP" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource KpOnAccentDeepBrush}" FontWeight="Black" FontSize="11" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="KeyPilot" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource KpTextBrush}" />
                        <TextBlock Text="掌机按键工作台" Margin="0,2,0,0" FontSize="9" Foreground="{StaticResource KpMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="工作台" Margin="10,0,10,7" FontSize="9" FontWeight="Bold" CharacterSpacing="110" Foreground="{StaticResource KpDimBrush}" />

                <StackPanel Grid.Row="2" Spacing="5">
                    <Button x:Name="CaptureNavButton" Click="CaptureMode_Click" HorizontalContentAlignment="Stretch" Padding="10" MinHeight="46" CornerRadius="10" Background="{StaticResource KpAccentSoftBrush}" BorderBrush="{StaticResource KpAccentSoftBorderBrush}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="25" Height="25" CornerRadius="7" BorderBrush="{StaticResource KpAccentRingBrush}" BorderThickness="1">
                                <TextBlock Text="IN" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="8" FontWeight="Bold" Foreground="{StaticResource KpMintBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="采集与测试" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="识别设备输入" Margin="0,2,0,0" FontSize="9" Foreground="{StaticResource KpDimBrush}" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button x:Name="MappingNavButton" Click="MappingMode_Click" HorizontalContentAlignment="Stretch" Padding="10" MinHeight="46" CornerRadius="10" Background="Transparent" BorderBrush="Transparent">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="25" Height="25" CornerRadius="7" BorderBrush="{StaticResource KpSubtleStrokeBrush}" BorderThickness="1">
                                <TextBlock Text="MAP" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="7" FontWeight="Bold" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="映射方案" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="同一面板直接设置" Margin="0,2,0,0" FontSize="9" Foreground="{StaticResource KpDimBrush}" />
                            </StackPanel>
                            <Border Grid.Column="2" MinWidth="22" Height="20" Padding="6,0" CornerRadius="10" Background="{StaticResource KpSubtleFillBrush}">
                                <TextBlock x:Name="MappingCountText" Text="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9" Foreground="{StaticResource KpMutedBrush}" />
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>

                <Border Grid.Row="3" Margin="0,18,0,0" Padding="10" CornerRadius="10" BorderBrush="{StaticResource KpBlueSoftBorderBrush}" BorderThickness="1" Background="{StaticResource KpBlueSoftBrush}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="编辑方案 · PROFILE" FontSize="8" Foreground="{StaticResource KpDimBrush}" />
                            <TextBlock x:Name="ProfileNameText" Text="掌机默认配置" Margin="0,4,0,0" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ProfileSourceText" Text="未启用应用自动切换" Margin="0,3,0,0" FontSize="8" Foreground="{StaticResource KpMutedBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="管理" Click="OpenProfileSettings_Click" Padding="8,4" VerticalAlignment="Center" Style="{StaticResource KpButtonStyle}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="5" Spacing="10">
                    <StackPanel Spacing="7">
                        <TextBlock Text="外观主题" FontSize="9" FontWeight="Bold" CharacterSpacing="110" Foreground="{StaticResource KpDimBrush}" />
                        <Grid x:Name="AppearanceThemeSwatchHost" />
                    </StackPanel>
                    <Border Padding="10" CornerRadius="10" BorderBrush="{StaticResource KpAmberSoftBorderBrush}" BorderThickness="1" Background="{StaticResource KpAmberSoftBrush}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource KpAmberBrush}" />
                                <TextBlock Text="安全退出" FontSize="10" Foreground="{StaticResource KpAmberBrightBrush}" />
                            </StackPanel>
                            <TextBlock Text="在同一键盘按住左 Ctrl + 左 Shift + F12 约 2 秒，可触发驱动紧急旁路。" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="8" LineHeight="12" Foreground="{StaticResource KpMutedBrush}" />
                        </StackPanel>
                    </Border>
                    <Grid Margin="4,0,4,0">
                        <TextBlock Text="LOCAL BUILD" FontSize="8" Foreground="{StaticResource KpDimBrush}" />
                        <TextBlock x:Name="VersionText" Text="—" HorizontalAlignment="Right" FontSize="8" Foreground="{StaticResource KpDimBrush}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="62" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource KpHairlineBrush}" BorderThickness="0,0,0,1" Background="{StaticResource KpTopBarBrush}">
                <Grid Padding="24,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="KeyPilot" FontSize="10" Foreground="{StaticResource KpMutedBrush}" />
                        <TextBlock Text="/" FontSize="10" Foreground="{StaticResource KpDimBrush}" />
                        <TextBlock x:Name="BreadcrumbModeText" Text="采集与测试" FontSize="10" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="13" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Padding="8,5" CornerRadius="12" Background="{StaticResource KpBlueBadgeBrush}" BorderBrush="{StaticResource KpBlueBadgeBorderBrush}" BorderThickness="1">
                            <TextBlock Text="WINUI 开发版" FontSize="8" FontWeight="Bold" Foreground="{StaticResource KpBlueBrightBrush}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse x:Name="ServiceDot" Width="6" Height="6" Fill="{StaticResource KpAmberBrush}" />
                            <TextBlock x:Name="ServiceStatusText" Text="等待 Raw Input" FontSize="9" Foreground="{StaticResource KpMutedBrush}" />
                        </StackPanel>
                        <Rectangle Width="1" Height="28" Fill="{StaticResource KpFaintFillBrush}" />
                        <StackPanel>
                            <TextBlock Text="全局映射" FontSize="8" />
                            <TextBlock x:Name="MasterStateText" Text="驱动尚未启用" Margin="0,2,0,0" FontSize="8" Foreground="{StaticResource KpAmberBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="MasterToggle" Toggled="MasterToggle_Toggled" OffContent="" OnContent="" ToolTipService.ToolTip="启用全局映射；驱动不可用时使用仅键盘兼容抑制" />
                        <Button x:Name="TrayMinimizeButton" Content="缩小到托盘" Click="HideToTray_Click" Style="{StaticResource KpButtonStyle}" Padding="10,0" MinHeight="28" FontSize="9" ToolTipService.ToolTip="窗口藏到托盘，映射继续在后台运行" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel x:Name="CompactNavBar" Grid.Row="1" Orientation="Horizontal" Spacing="6" Padding="24,8,24,0" Visibility="Collapsed">
                <Button Content="采集" Click="CaptureMode_Click" Style="{StaticResource KpButtonStyle}" Padding="10,0" MinHeight="28" />
                <Button Content="映射" Click="MappingMode_Click" Style="{StaticResource KpButtonStyle}" Padding="10,0" MinHeight="28" />
            </StackPanel>

            <Grid x:Name="MainContentHost" Grid.Row="2">
            <ScrollViewer x:Name="WorkspaceScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid HorizontalAlignment="Stretch" Padding="24,22,24,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock x:Name="PageTitleText" Text="采集与测试" FontSize="25" FontWeight="SemiBold" CharacterSpacing="-28" />
                            <TextBlock x:Name="PageDescriptionText" Text="按下设备按键查看真实 Raw Input；在任意按键上右键创建映射。" Margin="0,5,0,0" FontSize="10" Foreground="{StaticResource KpMutedBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Border Padding="3" CornerRadius="9" BorderBrush="{StaticResource KpLineBrush}" BorderThickness="1" Background="{StaticResource KpSidebarBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="CaptureModeButton" Content="采集" Click="CaptureMode_Click" Height="29" Padding="12,0" CornerRadius="6" Background="{StaticResource KpPanelSecondaryBrush}" BorderThickness="0" />
                                    <Button x:Name="MappingModeButton" Content="映射" Click="MappingMode_Click" Height="29" Padding="12,0" CornerRadius="6" Background="Transparent" BorderThickness="0" Foreground="{StaticResource KpMutedBrush}" />
                                </StackPanel>
                            </Border>
                            <Button x:Name="InputDiagnosticButton" Content="诊断 10 秒" Click="InputDiagnostic_Click" Style="{StaticResource KpButtonStyle}" ToolTipService.ToolTip="短时记录脱敏的 XInput、Raw Keyboard 和 Raw HID 原始事件" />
                            <Button x:Name="ClearHistoryButton" Content="清空记录" Click="ClearHistory_Click" Style="{StaticResource KpButtonStyle}" />
                            <Button x:Name="CaptureToggleButton" Content="● 正在采集" Click="CaptureToggle_Click" Style="{StaticResource KpButtonStyle}" Background="{StaticResource KpMintBrush}" BorderBrush="{StaticResource KpMintBrush}" Foreground="{StaticResource KpOnAccentBrush}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Height="118" Margin="0,0,0,13" Style="{StaticResource KpCardStyle}">
                        <Grid>
                        <Grid x:Name="CaptureStatusPanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="0.72*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Padding="17,14" VerticalAlignment="Center">
                                <TextBlock Text="输入来源" FontSize="8" FontWeight="Bold" CharacterSpacing="65" Foreground="{StaticResource KpDimBrush}" />
                                <Border Margin="0,9,0,0" Padding="8,5" HorizontalAlignment="Left" CornerRadius="12" Background="{StaticResource KpBlueBadgeBrush}" BorderBrush="{StaticResource KpBlueBadgeBorderBrush}" BorderThickness="1">
                                    <TextBlock x:Name="RecentSourceText" Text="等待输入" FontSize="8" FontWeight="Bold" Foreground="{StaticResource KpBlueBrightBrush}" />
                                </Border>
                                <Button x:Name="CopyDetectedInputButton" Content="复制按键信息" Click="CopyDetectedInput_Click" IsEnabled="False" Margin="0,7,0,0" Padding="9,3" HorizontalAlignment="Left" Style="{StaticResource KpButtonStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Padding="17,14" BorderBrush="{StaticResource KpHairlineBrush}" BorderThickness="1,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="RecentKeyText" Text="—" FontSize="27" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="RecentNameText" Text="尚未检测到输入" Margin="0,3,0,0" FontSize="9" Foreground="{StaticResource KpMintBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Grid Grid.Column="2" Padding="17,14" BorderBrush="{StaticResource KpHairlineBrush}" BorderThickness="1,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="VK" FontSize="8" Foreground="{StaticResource KpDimBrush}" />
                                    <TextBlock x:Name="RecentVirtualKeyText" Text="—" Margin="0,5,0,0" FontFamily="Consolas" FontSize="9" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="SCAN CODE" FontSize="8" Foreground="{StaticResource KpDimBrush}" />
                                    <TextBlock x:Name="RecentCodeText" Text="—" Margin="0,5,0,0" FontFamily="Consolas" FontSize="9" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="位置" FontSize="8" Foreground="{StaticResource KpDimBrush}" />
                                    <TextBlock x:Name="RecentLocationText" Text="—" Margin="0,5,0,0" FontFamily="Consolas" FontSize="9" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="状态" FontSize="8" Foreground="{StaticResource KpDimBrush}" />
                                    <TextBlock x:Name="RecentStateText" Text="WAITING" Margin="0,5,0,0" FontFamily="Consolas" FontSize="9" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Column="3" Padding="17,14" BorderBrush="{StaticResource KpHairlineBrush}" BorderThickness="1,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="最近输入" FontSize="8" FontWeight="Bold" Foreground="{StaticResource KpDimBrush}" />
                                <StackPanel x:Name="RecentHistoryPanel" Margin="0,9,0,0" Spacing="5">
                                    <TextBlock Text="暂无记录" FontSize="9" Foreground="{StaticResource KpMutedBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="MappingStatusPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="0.78*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Padding="17,14" VerticalAlignment="Center">
                                <TextBlock Text="来源按键" FontSize="8" FontWeight="Bold" Foreground="{StaticResource KpDimBrush}" />
                                <TextBlock x:Name="SelectedSourceText" Text="请选择来源按键" Margin="0,8,0,0" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="SelectedSourceCodeText" Text="—" Margin="0,5,0,0" FontFamily="Consolas" FontSize="8" Foreground="{StaticResource KpMutedBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="→" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{StaticResource KpMintBrush}" />
                            <StackPanel Grid.Column="2" Padding="17,14" VerticalAlignment="Center">
                                <TextBlock Text="目标动作" FontSize="8" FontWeight="Bold" Foreground="{StaticResource KpDimBrush}" />
                                <TextBlock x:Name="SelectedTargetText" Text="尚未设置映射" Margin="0,8,0,0" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource KpMintBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="SelectedActionTypeText" Text="在按键上右键创建" Margin="0,5,0,0" FontSize="8" Foreground="{StaticResource KpMutedBrush}" />
                            </StackPanel>
                            <Grid Grid.Column="3" Padding="17,14" BorderBrush="{StaticResource KpHairlineBrush}" BorderThickness="1,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="触发方式" FontSize="8" Foreground="{StaticResource KpDimBrush}" />
                                    <TextBlock x:Name="SelectedTriggerText" Text="—" Margin="0,4,0,0" FontSize="9" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <TextBlock Text="原输入" FontSize="8" Foreground="{StaticResource KpDimBrush}" />
                                    <TextBlock x:Name="SelectedBlockText" Text="—" Margin="0,4,0,0" FontSize="9" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource KpCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Padding="14,0" BorderBrush="{StaticResource KpHairlineBrush}" BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                    <Border Width="25" Height="25" CornerRadius="7" Background="{StaticResource KpAccentFillBrush}" BorderBrush="{StaticResource KpAccentSoftBorderBrush}" BorderThickness="1">
                                        <TextBlock Text="KB" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="7" FontWeight="Bold" Foreground="{StaticResource KpMintBrush}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="常规键盘" FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock Text="完整键盘布局 · Raw Input" Margin="0,2,0,0" FontSize="8" Foreground="{StaticResource KpMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="KeyboardLastText" Text="等待真实键盘输入" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="8" Foreground="{StaticResource KpMutedBrush}" />
                            </Grid>

                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="14,14,14,11">
                                <Grid MinWidth="1120">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel x:Name="FunctionRowPanel" Orientation="Horizontal" Spacing="5" Margin="0,0,0,12" />
                                    <Grid Grid.Row="1" ColumnSpacing="13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="700" />
                                            <ColumnDefinition Width="166" />
                                            <ColumnDefinition Width="198" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel x:Name="KeyboardMainPanel" Spacing="5" />
                                        <Grid x:Name="NavigationGrid" Grid.Column="1" />
                                        <Grid x:Name="NumpadGrid" Grid.Column="2" />
                                    </Grid>
                                    <Grid Grid.Row="2" Margin="0,10,0,0">
                                        <TextBlock Text="左击测试 · 右键设置映射" FontSize="8" Foreground="{StaticResource KpMutedBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="13" HorizontalAlignment="Right">
                                            <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="7" Height="7" Fill="{StaticResource KpMintBrush}" /><TextBlock Text="已映射" FontSize="8" Foreground="{StaticResource KpMutedBrush}" /></StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="16" Height="9" CornerRadius="3" Background="{StaticResource KpMintBrush}" /><TextBlock Text="映射模式突出显示" FontSize="8" Foreground="{StaticResource KpMutedBrush}" /></StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Grid x:Name="LowerGrid" Grid.Row="3" Margin="0,13,0,0" ColumnSpacing="13" RowSpacing="13">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.78*" /><ColumnDefinition Width="1.22*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                        <Border x:Name="GamepadCard" Grid.Column="0" Style="{StaticResource KpCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="50" /><RowDefinition Height="286" /></Grid.RowDefinitions>
                                <Grid Padding="14,0" BorderBrush="{StaticResource KpHairlineBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                        <Border Width="25" Height="25" CornerRadius="7" Background="{StaticResource KpAccentFillBrush}"><TextBlock Text="PAD" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="7" FontWeight="Bold" Foreground="{StaticResource KpMintBrush}" /></Border>
                                        <StackPanel><TextBlock Text="手柄" FontSize="11" FontWeight="SemiBold" /><TextBlock x:Name="GamepadSubtitleText" Text="XInput 1.4 · 只读采集" Margin="0,2,0,0" FontSize="8" Foreground="{StaticResource KpMutedBrush}" /></StackPanel>
                                    </StackPanel>
                                    <TextBlock x:Name="GamepadBackendStatusText" Text="正在等待手柄" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="8" Foreground="{StaticResource KpAmberBrush}" />
                                </Grid>
                                <Grid Grid.Row="1" Padding="15,10,15,10" RowSpacing="6">
                                    <Grid.RowDefinitions><RowDefinition Height="218" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                    <Border Width="310" Height="218" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="78,78,70,70" BorderBrush="{StaticResource KpDeviceShellLineBrush}" BorderThickness="1" Background="{StaticResource KpDeviceShellBrush}">
                                        <Canvas x:Name="GamepadSurface" Width="310" Height="218" />
                                    </Border>
                                    <TextBlock x:Name="StickAnalysisText" Grid.Row="1" Text="已检测 0 个摇杆 · 转动摇杆后自动估算角度与精度" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="8" Foreground="{StaticResource KpMutedBrush}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border x:Name="SpecialCard" Grid.Column="1" Style="{StaticResource KpCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="50" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid Padding="14,0" BorderBrush="{StaticResource KpHairlineBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                        <Border Width="25" Height="25" CornerRadius="7" Background="{StaticResource KpAccentFillBrush}"><TextBlock Text="HID" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="7" FontWeight="Bold" Foreground="{StaticResource KpMintBrush}" /></Border>
                                        <StackPanel><TextBlock Text="特殊按键 / 输入模式" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="点空槽采集特殊键；右键可录制完整 2 秒按键过程" Margin="0,2,0,0" FontSize="8" Foreground="{StaticResource KpMutedBrush}" /></StackPanel>
                                    </StackPanel>
                                    <TextBlock x:Name="HidBackendStatusText" Text="等待 HID" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="8" Foreground="{StaticResource KpMutedBrush}" />
                                </Grid>
                                <Grid x:Name="SpecialSlotsGrid" Grid.Row="1" Padding="12" ColumnSpacing="7" RowSpacing="7" />
                            </Grid>
                        </Border>

                        <Border x:Name="RemoteCard" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource KpCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="50" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid Padding="14,0" BorderBrush="{StaticResource KpHairlineBrush}" BorderThickness="0,0,0,1">
