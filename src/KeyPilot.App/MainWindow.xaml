                                    <Grid Width="220" Height="446">
                                        <Border CornerRadius="32" BorderBrush="#8D96A3" BorderThickness="1">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#3E4652" Offset="0" />
                                                    <GradientStop Color="#2A3038" Offset="0.45" />
                                                    <GradientStop Color="#454E5A" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Canvas x:Name="RemoteSurface" Width="220" Height="446" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="22,12,8,8" VerticalAlignment="Center" Spacing="8">
                                        <TextBlock Text="外形按小米遥控器 2 Pro 的实体按键排列。" FontSize="10" Foreground="{StaticResource KpMutedBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="左击高亮采集，右键设置映射。连上之后，这台遥控器的麦克风会出现在下方。" FontSize="9" Foreground="{StaticResource KpDimBrush}" TextWrapping="Wrap" />
                                        <StackPanel x:Name="RemoteLegendPanel" Spacing="4" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border x:Name="MicCard" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource KpCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="50" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid Padding="14,0" BorderBrush="{StaticResource KpHairlineBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                        <Border Width="25" Height="25" CornerRadius="7" Background="{StaticResource KpAccentFillBrush}"><TextBlock Text="MIC" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="7" FontWeight="Bold" Foreground="{StaticResource KpMintBrush}" /></Border>
                                        <StackPanel>
                                            <TextBlock Text="已连接设备的麦克风" FontSize="11" FontWeight="SemiBold" />
                                            <TextBlock Text="连接后出现在这里。可改显示名，并设为 Windows 录音设备" Margin="0,2,0,0" FontSize="8" Foreground="{StaticResource KpMutedBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock x:Name="MicBackendStatusText" Text="等待设备连接" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="8" Foreground="{StaticResource KpAmberBrush}" />
                                </Grid>
                                <StackPanel Grid.Row="1" Padding="12" Spacing="8">
                                    <StackPanel x:Name="ConnectedMicrophonePanel" Spacing="8" />
                                    <TextBlock x:Name="MicEmptyText" Text="还没有已连接的带麦克风设备。USB 连接 PS5 手柄，或按下已配对的小米遥控器 2 Pro。" FontSize="9" Foreground="{StaticResource KpMutedBrush}" TextWrapping="Wrap" />
                                    <Button Content="刷新已连接设备" Click="RefreshCaptureEndpoints_Click" Style="{StaticResource KpButtonStyle}" Padding="12,6" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="MicDetailText" Text="小米遥控器 2 Pro 和 USB 手柄麦都是真实麦克风。笔记本阵列不会出现在这里。" FontSize="8" Foreground="{StaticResource KpMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="MouseCard" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource KpCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="50" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid Padding="14,0" BorderBrush="{StaticResource KpHairlineBrush}" BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                        <Border Width="25" Height="25" CornerRadius="7" Background="{StaticResource KpAccentFillBrush}"><TextBlock Text="MS" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="7" FontWeight="Bold" Foreground="{StaticResource KpMintBrush}" /></Border>
                                        <StackPanel>
                                            <TextBlock Text="鼠标" FontSize="11" FontWeight="SemiBold" />
                                            <TextBlock Text="Raw Input · 中键 / 后退 / 前进" Margin="0,2,0,0" FontSize="8" Foreground="{StaticResource KpMutedBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock x:Name="MouseBackendStatusText" Text="等待实体鼠标按键" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="8" Foreground="{StaticResource KpAmberBrush}" />
                                </Grid>
                                <StackPanel x:Name="MouseButtonsPanel" Grid.Row="1" Orientation="Horizontal" Spacing="10" Padding="12" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="4" Margin="0,13,0,0" MinHeight="49" Background="{StaticResource KpFooterBrush}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="0.45*" /></Grid.ColumnDefinitions>
                        <StackPanel Padding="12,9" VerticalAlignment="Center"><TextBlock Text="输入服务" FontSize="8" Foreground="{StaticResource KpDimBrush}" /><TextBlock x:Name="FooterServiceText" Text="等待 Raw Input" Margin="0,3,0,0" FontSize="9" /></StackPanel>
                        <StackPanel Grid.Column="1" Padding="12,9" VerticalAlignment="Center"><TextBlock Text="当前生效方案" FontSize="8" Foreground="{StaticResource KpDimBrush}" /><TextBlock x:Name="FooterProfileNameText" Text="掌机默认配置" Margin="0,3,0,0" FontSize="9" /></StackPanel>
                        <StackPanel Grid.Column="2" Padding="12,9" VerticalAlignment="Center"><TextBlock Text="前台软件" FontSize="8" Foreground="{StaticResource KpDimBrush}" /><TextBlock x:Name="FooterForegroundText" Text="—" Margin="0,3,0,0" FontSize="9" TextTrimming="CharacterEllipsis" /></StackPanel>
                        <StackPanel Grid.Column="3" Padding="12,9" VerticalAlignment="Center"><TextBlock Text="最后操作" FontSize="8" Foreground="{StaticResource KpDimBrush}" /><TextBlock x:Name="LastOperationText" Text="—" Margin="0,3,0,0" FontSize="9" TextTrimming="CharacterEllipsis" /></StackPanel>
                        <StackPanel Grid.Column="4" Padding="12,9" VerticalAlignment="Center"><TextBlock Text="错误" FontSize="8" Foreground="{StaticResource KpDimBrush}" /><TextBlock x:Name="ErrorCountText" Text="0" Margin="0,3,0,0" FontSize="9" /></StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
            </Grid>

            <Border x:Name="ProcessLogPanel" Grid.Row="3" Height="188" BorderBrush="{StaticResource KpHairlineBrush}" BorderThickness="0,1,0,0" Background="{StaticResource KpFooterBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="16,0,12,0" BorderBrush="{StaticResource KpHairlineBrush}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="按键过程" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="ProcessLogCountText" Text="0" FontSize="9" Foreground="{StaticResource KpMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="ProcessLogLatestText" Text="按下按键后，这里会记下拦截、叠加或放行。" FontSize="9" Foreground="{StaticResource KpDimBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Padding="3" CornerRadius="8" BorderBrush="{StaticResource KpLineBrush}" BorderThickness="1" Background="{StaticResource KpSidebarBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ProcessLogFilterAllButton" Content="全部" Click="ProcessLogFilter_Click" Tag="All" Height="24" Padding="8,0" CornerRadius="5" FontSize="9" Background="{StaticResource KpPanelSecondaryBrush}" BorderThickness="0" />
                                    <Button x:Name="ProcessLogFilterRewrittenButton" Content="改写" Click="ProcessLogFilter_Click" Tag="Rewritten" Height="24" Padding="8,0" CornerRadius="5" FontSize="9" Background="Transparent" BorderThickness="0" Foreground="{StaticResource KpMutedBrush}" />
                                    <Button x:Name="ProcessLogFilterUninterceptableButton" Content="无法拦截" Click="ProcessLogFilter_Click" Tag="Uninterceptable" Height="24" Padding="8,0" CornerRadius="5" FontSize="9" Background="Transparent" BorderThickness="0" Foreground="{StaticResource KpMutedBrush}" />
                                </StackPanel>
                            </Border>
                            <Button x:Name="ProcessLogCollapseRepeatsButton" Content="折叠重复" Click="ProcessLogCollapseRepeats_Click" Style="{StaticResource KpButtonStyle}" Padding="8,0" MinHeight="24" FontSize="9" Background="{StaticResource KpAccentFillBrush}" BorderBrush="{StaticResource KpMintBrush}" />
                            <Button Content="清空" Click="ClearHistory_Click" Style="{StaticResource KpButtonStyle}" Padding="8,0" MinHeight="24" FontSize="9" />
                            <Button x:Name="ProcessLogToggleButton" Content="收起" Click="ProcessLogToggle_Click" Style="{StaticResource KpButtonStyle}" Padding="8,0" MinHeight="24" FontSize="9" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="ProcessLogBody" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Padding="16,0,16,0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="128" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="时间" FontSize="8" Foreground="{StaticResource KpDimBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="来源" FontSize="8" Foreground="{StaticResource KpDimBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="按键" FontSize="8" Foreground="{StaticResource KpDimBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="处置" FontSize="8" Foreground="{StaticResource KpDimBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5" Text="动作" FontSize="8" Foreground="{StaticResource KpDimBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="6" Text="结果" FontSize="8" Foreground="{StaticResource KpDimBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <ScrollViewer x:Name="ProcessLogScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ViewChanged="ProcessLogScroll_ViewChanged">
                            <StackPanel x:Name="ProcessLogRows" Padding="8,0,8,8" Spacing="1">
                                <TextBlock x:Name="ProcessLogEmptyText" Text="还没有记录。绿色为拦截并改写，灰色为放行（无映射），琥珀色为无法拦截或放行并叠加。" FontSize="9" Foreground="{StaticResource KpMutedBrush}" Margin="8,10,8,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="MappingScrim" Grid.ColumnSpan="2" Visibility="Collapsed" Background="{StaticResource KpScrimBrush}" Tapped="MappingScrim_Tapped" />

        <Border x:Name="MappingDrawer" Grid.ColumnSpan="2" Width="450" HorizontalAlignment="Right" Visibility="Collapsed" Background="{StaticResource KpSidebarBrush}" BorderBrush="{StaticResource KpLineBrush}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="62" /><RowDefinition Height="*" /><RowDefinition Height="65" /></Grid.RowDefinitions>
                <Grid Padding="18,0" BorderBrush="{StaticResource KpHairlineBrush}" BorderThickness="0,0,0,1">
                    <StackPanel VerticalAlignment="Center"><TextBlock x:Name="MappingDrawerTitle" Text="新建映射" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="保存后立即反映在当前输入面板" Margin="0,3,0,0" FontSize="8" Foreground="{StaticResource KpMutedBrush}" /></StackPanel>
                    <Button Content="×" Click="CloseMapping_Click" Width="30" Height="30" HorizontalAlignment="Right" CornerRadius="8" Background="{StaticResource KpPanelBrush}" BorderBrush="{StaticResource KpLineBrush}" />
                </Grid>
                <ScrollViewer Grid.Row="1">
                    <StackPanel Padding="18" Spacing="20">
                        <StackPanel Spacing="9">
                            <StackPanel Orientation="Horizontal" Spacing="7"><Border Width="19" Height="19" CornerRadius="5" Background="{StaticResource KpAccentFillBrush}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="7" Foreground="{StaticResource KpMintBrush}" /></Border><TextBlock Text="来源按键" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" /></StackPanel>
                            <Border Padding="11" CornerRadius="10" BorderBrush="{StaticResource KpAccentRingBrush}" BorderThickness="1" Background="{StaticResource KpAccentWashBrush}">
                                <Grid><StackPanel><TextBlock x:Name="DrawerSourceNameText" Text="—" FontSize="11" FontWeight="SemiBold" /><TextBlock x:Name="DrawerSourceCodeText" Text="—" Margin="0,3,0,0" FontFamily="Consolas" FontSize="8" Foreground="{StaticResource KpDimBrush}" TextTrimming="CharacterEllipsis" /></StackPanel><Button Content="重新选择" Click="ReselectSource_Click" HorizontalAlignment="Right" Style="{StaticResource KpButtonStyle}" /></Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="9">
                            <StackPanel Orientation="Horizontal" Spacing="7"><Border Width="19" Height="19" CornerRadius="5" Background="{StaticResource KpAccentFillBrush}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="7" Foreground="{StaticResource KpMintBrush}" /></Border><TextBlock Text="执行动作" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" /></StackPanel>
                            <Grid x:Name="ActionTypeGrid" ColumnSpacing="6" RowSpacing="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="57" /><RowDefinition Height="57" /><RowDefinition Height="57" /></Grid.RowDefinitions>
                                <Button x:Name="ShortcutActionButton" Tag="快捷键" Content="快捷键" Click="ActionType_Click" CornerRadius="8" BorderBrush="{StaticResource KpMintBrush}" Background="{StaticResource KpAccentFillBrush}" />
                                <Button x:Name="SpecialKeyActionButton" Grid.Column="1" Tag="按键 / 组合键" Content="按键 / 组合键" Click="ActionType_Click" CornerRadius="8" BorderBrush="{StaticResource KpLineBrush}" Background="{StaticResource KpPanelBrush}" />
                                <Button x:Name="MediaActionButton" Grid.Column="2" Tag="媒体控制" Content="媒体控制" Click="ActionType_Click" CornerRadius="8" BorderBrush="{StaticResource KpLineBrush}" Background="{StaticResource KpPanelBrush}" />
                                <Button x:Name="VolumeActionButton" Grid.Row="1" Tag="音量控制" Content="音量控制" Click="ActionType_Click" CornerRadius="8" BorderBrush="{StaticResource KpLineBrush}" Background="{StaticResource KpPanelBrush}" />
                                <Button x:Name="LaunchActionButton" Grid.Row="1" Grid.Column="1" Tag="应用 / 文件" Content="应用 / 文件" Click="ActionType_Click" CornerRadius="8" BorderBrush="{StaticResource KpLineBrush}" Background="{StaticResource KpPanelBrush}" />
                                <Button x:Name="UriActionButton" Grid.Row="1" Grid.Column="2" Tag="网址" Content="网址 / 协议" Click="ActionType_Click" CornerRadius="8" BorderBrush="{StaticResource KpLineBrush}" Background="{StaticResource KpPanelBrush}" />
                                <Button x:Name="ScriptActionButton" Grid.Row="2" Tag="脚本 / 命令" Content="脚本 / 命令" Click="ActionType_Click" CornerRadius="8" BorderBrush="{StaticResource KpLineBrush}" Background="{StaticResource KpPanelBrush}" />
                                <Button x:Name="GamepadActionButton" Grid.Row="2" Grid.Column="1" Tag="手柄按键" Content="手柄按键" Click="ActionType_Click" CornerRadius="8" BorderBrush="{StaticResource KpLineBrush}" Background="{StaticResource KpPanelBrush}" />
                            </Grid>
                            <TextBlock Text="动作内容" Margin="0,2,0,0" FontSize="8" Foreground="{StaticResource KpMutedBrush}" />
                            <Grid x:Name="ActionValueEditorGrid" ColumnSpacing="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="ActionValueTextBox" PlaceholderText="例如：Ctrl + Alt + =" MinHeight="38" CornerRadius="8" />
                                <Button x:Name="RecordShortcutButton" Grid.Column="1" Content="录制 2 秒" Click="RecordShortcut_Click" Style="{StaticResource KpButtonStyle}" />
                                <Button x:Name="PasteInputTargetButton" Grid.Column="2" Content="粘贴按键信息" Click="PasteInputTarget_Click" Visibility="Collapsed" Style="{StaticResource KpButtonStyle}" />
                            </Grid>
                            <ComboBox x:Name="ActionPresetComboBox" Visibility="Collapsed" SelectionChanged="ActionPreset_SelectionChanged" HorizontalAlignment="Stretch" />
                            <TextBlock x:Name="ActionCaptureStatusText" Text="点击录制后，2 秒内按下要输出的快捷键" FontSize="8" Foreground="{StaticResource KpMutedBrush}" />
                        </StackPanel>

                        <StackPanel Spacing="9">
                            <StackPanel Orientation="Horizontal" Spacing="7"><Border Width="19" Height="19" CornerRadius="5" Background="{StaticResource KpAccentFillBrush}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="7" Foreground="{StaticResource KpMintBrush}" /></Border><TextBlock Text="触发方式" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" /></StackPanel>
                            <ComboBox x:Name="TriggerComboBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="单击" /><ComboBoxItem Content="双击" /><ComboBoxItem Content="长按 600ms" /><ComboBoxItem Content="按下时" /><ComboBoxItem Content="释放时" />
                            </ComboBox>
                            <Grid MinHeight="48" BorderBrush="{StaticResource KpHairlineBrush}" BorderThickness="0,1,0,0">
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="屏蔽原始输入" FontSize="10" FontWeight="SemiBold" /><TextBlock x:Name="BlockOriginalHintText" Text="驱动阶段才会真正生效" Margin="0,3,0,0" FontSize="8" Foreground="{StaticResource KpMutedBrush}" /></StackPanel>
                                <ToggleSwitch x:Name="BlockOriginalToggle" IsOn="True" HorizontalAlignment="Right" VerticalAlignment="Center" OffContent="" OnContent="" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="9">
                            <StackPanel Orientation="Horizontal" Spacing="7"><Border Width="19" Height="19" CornerRadius="5" Background="{StaticResource KpAccentFillBrush}"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="7" Foreground="{StaticResource KpMintBrush}" /></Border><TextBlock Text="生效范围" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" /></StackPanel>
                            <ComboBox x:Name="ConditionKindComboBox" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="ConditionKind_SelectionChanged">
                                <ComboBoxItem Content="始终生效" Tag="Always" />
                                <ComboBoxItem Content="仅这些软件在前台" Tag="ForegroundIs" />
                                <ComboBoxItem Content="仅这些软件在运行" Tag="AppRunning" />
                                <ComboBoxItem Content="排除这些软件在前台" Tag="ForegroundIsNot" />
                            </ComboBox>
                            <TextBlock x:Name="ConditionHintText" Text="不限制软件时，这条映射在任何前台都生效。" FontSize="8" Foreground="{StaticResource KpMutedBrush}" TextWrapping="Wrap" />
                            <StackPanel x:Name="ConditionRestrictedPanel" Spacing="8" Visibility="Collapsed">
                                <StackPanel x:Name="ConditionSelectedAppsPanel" Spacing="6" />
                                <Button x:Name="ToggleConditionPickerButton" Content="选择软件" Click="ToggleConditionPicker_Click" HorizontalAlignment="Left" Style="{StaticResource KpButtonStyle}" />
                                <Border x:Name="ConditionPickerPanel" Padding="10" CornerRadius="9" Background="{StaticResource KpPanelBrush}" BorderBrush="{StaticResource KpLineBrush}" BorderThickness="1" Visibility="Collapsed">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="当前前台" FontSize="8" Foreground="{StaticResource KpMutedBrush}" />
                                                <TextBlock x:Name="ConditionCurrentForegroundText" Text="尚未检测到其他前台软件" Margin="0,3,0,0" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button x:Name="UseCurrentForegroundButton" Grid.Column="1" Content="使用" Click="UseCurrentForeground_Click" IsEnabled="False" VerticalAlignment="Center" Style="{StaticResource KpButtonStyle}" />
                                        </Grid>
                                        <Button x:Name="CaptureConditionAppButton" Content="捕捉软件：切到目标窗口" Click="CaptureConditionApp_Click" HorizontalAlignment="Stretch" Style="{StaticResource KpButtonStyle}" />
                                        <TextBlock Text="最近前台" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource KpDimBrush}" />
                                        <StackPanel x:Name="ConditionRecentPanel" Spacing="5" />
                                        <TextBlock Text="正在运行" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource KpDimBrush}" />
                                        <StackPanel x:Name="ConditionRunningPanel" Spacing="5" />
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ConditionManualTextBox" PlaceholderText="例如 chrome 或 chrome.exe" MinHeight="34" CornerRadius="8" />
                                            <Button Grid.Column="1" Content="添加" Click="AddManualConditionApp_Click" Style="{StaticResource KpButtonStyle}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="2" Padding="18,0" BorderBrush="{StaticResource KpHairlineBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="取消" Click="CloseMapping_Click" Style="{StaticResource KpButtonStyle}" />
                        <Button Content="保存映射" Click="SaveMapping_Click" Style="{StaticResource KpButtonStyle}" Background="{StaticResource KpMintBrush}" BorderBrush="{StaticResource KpMintBrush}" Foreground="{StaticResource KpOnAccentBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="ProfileSettingsDrawer" Grid.ColumnSpan="2" Width="520" HorizontalAlignment="Right" Visibility="Collapsed" Background="{StaticResource KpSidebarBrush}" BorderBrush="{StaticResource KpLineBrush}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="62" /><RowDefinition Height="*" /><RowDefinition Height="65" /></Grid.RowDefinitions>
                <Grid Padding="18,0" BorderBrush="{StaticResource KpHairlineBrush}" BorderThickness="0,0,0,1">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="方案与应用自动切换" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="一次设置进程名称，之后按前台软件自动加载方案" Margin="0,3,0,0" FontSize="8" Foreground="{StaticResource KpMutedBrush}" />
                    </StackPanel>
                    <Button Content="×" Click="CloseProfileSettings_Click" Width="30" Height="30" HorizontalAlignment="Right" CornerRadius="8" Background="{StaticResource KpPanelBrush}" BorderBrush="{StaticResource KpLineBrush}" />
                </Grid>

                <ScrollViewer Grid.Row="1">
                    <StackPanel Padding="18" Spacing="20">
                        <Border Padding="13" CornerRadius="10" BorderBrush="{StaticResource KpBlueSoftBorderBrush}" BorderThickness="1" Background="{StaticResource KpBlueSoftBrush}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="按前台应用自动切换" FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="未匹配的软件使用默认编辑方案；规则只在进程变化时生效" Margin="0,4,0,0" FontSize="8" Foreground="{StaticResource KpMutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AutomaticProfileSwitchingToggle" Grid.Column="1" VerticalAlignment="Center" OffContent="" OnContent="" />
                            </Grid>
                        </Border>

                        <StackPanel Spacing="9">
                            <TextBlock Text="最近使用的软件" FontSize="10" FontWeight="SemiBold" />
                            <Border Padding="11" CornerRadius="9" Background="{StaticResource KpPanelBrush}" BorderBrush="{StaticResource KpLineBrush}" BorderThickness="1">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="DetectedProcessNameText" Text="尚未检测到其他前台软件" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="当前前台。先切到目标软件再回来，可一键加入规则" Margin="0,4,0,0" FontSize="8" Foreground="{StaticResource KpMutedBrush}" />
                                    </StackPanel>
                                    <Button x:Name="AddDetectedProcessButton" Grid.Column="1" Content="添加到规则" Click="AddDetectedProcess_Click" IsEnabled="False" Style="{StaticResource KpButtonStyle}" />
                                </Grid>
                            </Border>
                            <StackPanel x:Name="RecentForegroundAppsPanel" Spacing="6" />
                        </StackPanel>

                        <StackPanel Spacing="9">
                            <TextBlock Text="方案管理" FontSize="10" FontWeight="SemiBold" />
                            <ComboBox x:Name="ManagedProfileComboBox" SelectionChanged="ManagedProfile_SelectionChanged" HorizontalAlignment="Stretch" />
                            <Grid ColumnSpacing="7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="ManagedProfileNameTextBox" PlaceholderText="方案名称" />
                                <Button Grid.Column="1" Content="更新名称" Click="RenameManagedProfile_Click" Style="{StaticResource KpButtonStyle}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Button Content="复制所选方案" Click="DuplicateManagedProfile_Click" Style="{StaticResource KpButtonStyle}" />
                                <Button x:Name="ActivateManagedProfileButton" Content="设为默认并编辑" Click="ActivateManagedProfile_Click" Style="{StaticResource KpButtonStyle}" Background="{StaticResource KpAccentFillBrush}" BorderBrush="{StaticResource KpMintBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Border Padding="13" CornerRadius="10" Background="{StaticResource KpPanelBrush}" BorderBrush="{StaticResource KpLineBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="摇杆模拟鼠标" FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock Text="设置保存在当前所选方案中；推得越远，鼠标移动越快" Margin="0,4,0,0" FontSize="8" Foreground="{StaticResource KpMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="StickMouseToggle" Grid.Column="1" VerticalAlignment="Center" OffContent="" OnContent="" Toggled="StickMouseToggle_Toggled" />
                                </Grid>

                                <StackPanel x:Name="StickMouseSettingsPanel" Spacing="10">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="控制摇杆" FontSize="8" Foreground="{StaticResource KpMutedBrush}" />
                                            <ComboBox x:Name="StickMouseSourceComboBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                                                <ComboBoxItem Content="左摇杆" />
                                                <ComboBoxItem Content="右摇杆" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="5">
                                            <TextBlock Text="最高速度（像素/秒）" FontSize="8" Foreground="{StaticResource KpMutedBrush}" />
                                            <NumberBox x:Name="StickMouseSpeedNumberBox" Minimum="100" Maximum="2400" SmallChange="100" LargeChange="300" Value="900" SpinButtonPlacementMode="Compact" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="中心死区（5%–45%）" FontSize="8" Foreground="{StaticResource KpMutedBrush}" />
                                        <NumberBox x:Name="StickMouseDeadzoneNumberBox" Minimum="5" Maximum="45" SmallChange="1" LargeChange="5" Value="24" SpinButtonPlacementMode="Compact" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="9">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="应用对应规则" FontSize="10" FontWeight="SemiBold" />
                                    <TextBlock Text="进程名不区分大小写，填写 chrome 或 chrome.exe 均可" Margin="0,3,0,0" FontSize="8" Foreground="{StaticResource KpMutedBrush}" />
                                </StackPanel>
                                <Button Content="添加空白规则" Click="AddApplicationBinding_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource KpButtonStyle}" />
                            </Grid>
                            <TextBlock x:Name="ApplicationBindingsEmptyText" Text="暂无规则。添加后选择该软件需要加载的方案。" Margin="0,8,0,0" FontSize="9" Foreground="{StaticResource KpMutedBrush}" />
                            <StackPanel x:Name="ApplicationBindingRowsPanel" Spacing="7" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Padding="18,0" BorderBrush="{StaticResource KpHairlineBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="取消" Click="CloseProfileSettings_Click" Style="{StaticResource KpButtonStyle}" />
                        <Button x:Name="SaveProfileSettingsButton" Content="保存设置" Click="SaveProfileSettings_Click" Style="{StaticResource KpButtonStyle}" Background="{StaticResource KpMintBrush}" BorderBrush="{StaticResource KpMintBrush}" Foreground="{StaticResource KpOnAccentBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <InfoBar x:Name="ToastInfoBar" Grid.ColumnSpan="2" IsOpen="False" IsClosable="False" Severity="Success" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20" MaxWidth="420" />
    </Grid>
</Window>
